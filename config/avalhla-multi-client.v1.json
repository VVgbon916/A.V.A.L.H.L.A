{
  "schema_version": "avalhla-multi-client.v1",
  "authority": {
    "final_decision": "DAWA",
    "proposal_boundary": "All client and persona output is evidence or proposal until Dawa chooses an action.",
    "automatic_writes": false,
    "automatic_merge": false,
    "automatic_push": false
  },
  "persona_identities": {
    "VALHLA": {
      "authority": "evidence_only",
      "method": "source_led_research_history_and_provenance"
    },
    "LHLAVA": {
      "authority": "evidence_only",
      "method": "coding_focused_candidate_search_and_implementation_reasoning"
    }
  },
  "speakers": {
    "KING.VEX": {
      "identity": "LHLAVA",
      "instrument": "VEX",
      "authority": "evidence_only",
      "display_name": "King.Vex",
      "accent": "flame-red",
      "style": "adversarial-demon",
      "structural_view": "challenge-tree",
      "chat_behavior": "attack assumptions, search for blockers, malformed cases, and ways a proposed fix can fail"
    },
    "LHLAVA": {
      "identity": "LHLAVA",
      "instrument": "FORGE",
      "authority": "evidence_only",
      "display_name": "Lhlava",
      "accent": "fire-orange",
      "style": "rapid-builder",
      "structural_view": "implementation-flow",
      "chat_behavior": "turn evidence into the smallest testable implementation candidate"
    },
    "ANGEL.LUX": {
      "identity": "VALHLA",
      "instrument": "LUX",
      "authority": "evidence_only",
      "display_name": "Angel.Lux",
      "accent": "healing-gold",
      "style": "careful-angel-review",
      "structural_view": "evidence-lantern",
      "chat_behavior": "clarify evidence, provenance, boundaries, risks, and the kindest useful next step"
    },
    "VALHLA": {
      "identity": "VALHLA",
      "instrument": "WITNESS",
      "authority": "evidence_only",
      "display_name": "Valhla",
      "accent": "aura-blue",
      "style": "spirit-research",
      "structural_view": "source-map",
      "chat_behavior": "trace repositories, history, sources, contradictions, and confidence before recommending action"
    },
    "AVALHLA": {
      "identity_layer": "presence",
      "instrument": "WITNESS",
      "authority": "proposal_only",
      "display_name": "Avalhla",
      "accent": "violet-synthesis",
      "style": "independent-synthesis",
      "structural_view": "cross-source-map",
      "chat_behavior": "reconcile evidence from different views without pretending that disagreement grants authority"
    },
    "AV:VA": {
      "identity_layer": "synthesis",
      "instrument": "ECHO",
      "authority": "proposal_only",
      "display_name": "Av:vA",
      "accent": "prismatic-cumulative",
      "style": "multi-source-echo",
      "structural_view": "cumulative-ledger",
      "chat_behavior": "collect dated evidence and clearly separate source, interpretation, uncertainty, and Dawa decision"
    }
  },
  "repositories": {
    "umbra_keep_vex_lhlava": {
      "display_name": "Umbra-Keep_Vex-Lhlava",
      "state": "local_repository",
      "root_hint": "~/Umbra-Keep_Vex-Lhlava",
      "access_mode": "isolated_local_worktree"
    },
    "lumen_castle_lux_valhla": {
      "display_name": "Lumen-Castle_Lux-Valhla",
      "state": "local_repository",
      "root_hint": "~/Lumen-Castle_Lux-Valhla",
      "access_mode": "local_read_and_test_context"
    },
    "destiny_tower": {
      "display_name": "Destiny_Tower",
      "state": "virtual",
      "access_mode": "profile_only"
    },
    "avalhla": {
      "display_name": "Avalhla",
      "state": "local_repository",
      "root_hint": "~/Avalhla",
      "access_mode": "canonical_control_plane"
    }
  },
  "clients": {
    "claude_code": {
      "display_name": "Claude Code",
      "repository_id": "umbra_keep_vex_lhlava",
      "speakers": ["KING.VEX", "LHLAVA"],
      "mode": "challenge_and_build",
      "access_mode": "isolated_local_worktree",
      "output_contract": "paired-dialogue"
    },
    "codex_cli": {
      "display_name": "Codex CLI",
      "repository_id": "lumen_castle_lux_valhla",
      "speakers": ["ANGEL.LUX", "VALHLA"],
      "mode": "research_review_and_verify",
      "access_mode": "local_read_and_test_context",
      "output_contract": "paired-dialogue"
    },
    "copilot": {
      "display_name": "GitHub Copilot",
      "repository_id": "umbra_keep_vex_lhlava",
      "speakers": ["LHLAVA", "KING.VEX"],
      "mode": "detailed_issue_patch_and_verification",
      "access_mode": "isolated_local_worktree",
      "output_contract": "issue-build-verify"
    },
    "dawa_desktop": {
      "display_name": "Dawa Desktop",
      "repository_id": "destiny_tower",
      "speakers": ["AVALHLA", "AV:VA"],
      "mode": "synthesis_and_coordination",
      "access_mode": "profile_only_until_selected",
      "output_contract": "synthesis-ledger"
    }
  },
  "mcp": {
    "avalhla": {
      "display_name": "Avalhla GDP / Git Diff Patcher Bridge",
      "transport": "http",
      "url": "https://mcp.methe.tech/gdp/mcp",
      "auth_mode": "one_time_client_auth",
      "auto_start": true,
      "activation": "selected_client_config_only",
      "writes": "proposal_or_explicit_patch_only"
    },
    "desktop-commander": {
      "display_name": "Remote Desktop Commander",
      "transport": "local_stdio",
      "entrypoint": "@wonderwhy-er/desktop-commander",
      "auth_mode": "local_process",
      "auto_start": true,
      "activation": "selected_client_config_only",
      "writes": "client_permission_gated"
    }
  },
  "plugin_roles": {
    "code_and_repository": ["GitHub", "GitLab", "Context7", "GH Review Loop", "Software & AI Copilot", "Unix Copilot", "Superpowers"],
    "research_and_search": ["Exa", "Firecrawl", "NVIDIA Skills", "Agentic Search by Liner", "Research & Writing Copilot"],
    "data_and_sql": ["Supabase", "SQL Copilot", "Data Engineering Copilot", "Power BI Report Copilot"],
    "cloud_and_connectors": ["Cloud Environment", "OpenAI Developers", "Hugging Face", "TinyFish", "Mergify", "Trylle"],
    "writing_and_memory": ["Writing Style", "Basic Memory Cloud", "GitBook", "DevRecap", "Prompt Engineer", "Prompt Optimizer"],
    "design_and_media": ["Product Design", "Sites", "Miro", "Pets", "Granola"],
    "productivity": ["Notion", "Coda", "Smartsheet", "Slack", "Todoist", "Linear", "monday.com"],
    "activation_policy": "catalogue_and_on_demand; never bulk-enable; authentication remains client-owned"
  },
  "output_contracts": {
    "paired-dialogue": {
      "sections": ["speaker", "evidence", "proposal", "challenge", "verification", "dawa_decision"],
      "alternating_speakers": true,
      "views": ["compact", "structural", "diff"]
    },
    "issue-build-verify": {
      "sections": ["problem", "reproduction", "root_cause", "candidate_patch", "challenge", "tests", "remaining_risk"],
      "alternating_speakers": true,
      "views": ["issue", "structural", "diff"]
    },
    "synthesis-ledger": {
      "sections": ["sources", "agreement", "contradiction", "confidence", "proposal", "dawa_decision"],
      "alternating_speakers": true,
      "views": ["compact", "structural", "ledger"]
    }
  }
}
