#!/usr/bin/env bash
# ai-ask -- one-shot question to Avalhla with ranked memory context
# Usage: ai-ask "your question"
#        ai-ask -n 5 "your question"    (top 5 ranked turns from today's session)
set -Eeuo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/lib_runtime.sh"

MEMORY_DIR="$AVA_MEMORY_DIR"
CONV_DIR="$AVA_CONVERSATIONS_DIR"
PROFILE_DIR="$AVA_PROFILES_DIR"
CONTEXT_BIN="$AVA_SCRIPTS_DIR/lib_context.sh"

MODEL="${AVALHLA_MODEL:-avalhla}"
SESSION_FILE="$CONV_DIR/$(date +%Y-%m-%d).jsonl"
PROFILE_FILE="$PROFILE_DIR/user-profile.txt"
RANK_BIN="$AVA_SCRIPTS_DIR/ava-context"

TURNS="${AVALHLA_MEMORY_TURNS:-8}"

if [[ "${1:-}" == "-n" ]]; then
    TURNS="${2:-$TURNS}"
    shift 2
fi

if [[ -z "${1:-}" ]]; then
    echo "Usage: ai-ask [-n N] \"your question\""
    exit 1
fi

QUESTION="$*"

if ! curl -fsS "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
    echo "X Ollama server not reachable"
    exit 1
fi

PROFILE=""
[[ -f "$PROFILE_FILE" ]] && PROFILE="$("$CONTEXT_BIN" file "$PROFILE_FILE" 2>/dev/null || true)"

CONTEXT=""
if [[ -f "$SESSION_FILE" ]]; then
    CONTEXT=$("$CONTEXT_BIN" file "$SESSION_FILE" 2>/dev/null | "$RANK_BIN" "$QUESTION" "$TURNS" 2>/dev/null || true)
fi

FULL_PROMPT="[TASK]
mode: ask
goal: answer the user's question. Use CONTEXT if relevant. Do not emit [READ:] tags.

"
if [[ -n "$PROFILE" || -n "$CONTEXT" ]]; then
    FULL_PROMPT+="[CONTEXT]
"
    [[ -n "$PROFILE" ]] && FULL_PROMPT+="--- user profile ---
$PROFILE

"
    [[ -n "$CONTEXT" ]] && FULL_PROMPT+="--- ranked turns ---
$CONTEXT

"
fi

FULL_PROMPT+="[USER]
$QUESTION"

curl -s "$OLLAMA_HOST/api/generate" \
    -d "$(jq -n --arg m "$MODEL" --arg p "$FULL_PROMPT" \
    '{model: $m, prompt: $p, stream: false}')" \
    | jq -r '.response'
