#!/usr/bin/env bash
set -Eeuo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$HERE/lib_runtime.sh"

DISPATCH="$AVA_SCRIPTS_DIR/lib_context.sh"

[[ -x "$DISPATCH" ]] || {
    printf '%s\n' 'X central context dispatcher unavailable' >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage:
  ai-read <path>             show file or list directory
  ai-read --ls <dir>         list directory
  ai-read --grep <pat> <dir> search pattern
  ai-read --tree <dir>       tree view
USAGE
}

case "${1:-}" in
    "")
        usage
        exit 0
        ;;
    --ls)
        target="${2:-}"
        [[ -n "$target" ]] || { printf '%s\n' 'X need dir' >&2; exit 1; }
        exec "$DISPATCH" ls "$target"
        ;;
    --grep)
        pattern="${2:-}"
        target="${3:-}"
        [[ -n "$pattern" && -n "$target" ]] || {
            printf '%s\n' 'X need pattern and dir' >&2
            exit 1
        }
        exec "$DISPATCH" grep "$pattern" "$target"
        ;;
    --tree)
        target="${2:-}"
        [[ -n "$target" ]] || { printf '%s\n' 'X need dir' >&2; exit 1; }
        exec "$DISPATCH" tree "$target"
        ;;
    *)
        target="$1"
        if [[ -d "$target" ]]; then
            exec "$DISPATCH" ls "$target"
        fi
        exec "$DISPATCH" file "$target"
        ;;
esac
