#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

PASS=0
FAIL=0
ok() { printf "  [ OK ] %s\n" "$1"; PASS=$((PASS + 1)); }
bad() { printf "  [FAIL] %s -- %s\n" "$1" "$2"; FAIL=$((FAIL + 1)); }
printf "%s\n" "== avalhla static contract =="
printf "root: %s\n\n" "$ROOT"
printf "%s\n" "-- canonical files --"
for f in docs/FAST_VIEW.md docs/AVALHLA_SPINE.md docs/PHASING.md docs/CO_BUILDER_TOOLBELT.md docs/DAWA_NOTEPAD.md config/sublime/Dawa_Avalhla.sublime-project config/sublime/Preferences.sublime-settings memory/auto-read/00_AI_COBUILD.json scripts/ava-cobuilder scripts/ava-sublime-update scripts/ava-resume scripts/ava-github-review scripts/ava-ci-contract AGENTS.md .github/workflows/avalhla-static-verify.yml; do
  [[ -f "$f" ]] && ok "present $f" || bad "present $f" "missing"
done

printf "%s\n" "" "-- shell syntax --"
while IFS= read -r -d "" f; do
  if bash -n "$f" >/dev/null 2>&1; then ok "bash -n ${f#$ROOT/}"; else bad "bash -n ${f#$ROOT/}" "syntax error"; fi
done < <(find scripts -maxdepth 1 -type f -perm -u+x -print0 2>/dev/null)

printf "%s\n" "" "-- JSON --"
if python3 -m json.tool memory/auto-read/00_AI_COBUILD.json >/dev/null; then ok "CoBuilder JSON parses"; else bad "CoBuilder JSON parses" "invalid JSON"; fi

printf "%s\n" "" "-- semantic invariants --"
if git grep -n -E "DAVVA|Dawa > AwA < Avalhla|Dawa > AvvA < Avalhla|Dawa <---- AwA ----> Avalhla" -- ":!memory/conversations/" ":!memory/reflections/" ":!memory/auto-read/00_AI_COBUILD.json" ":!scripts/ava-ci-contract" >/dev/null 2>&1; then
  bad "authority/relation naming" "active legacy or DAVVA label found"
else
  ok "authority/relation naming"
fi
missing_alias=0
for alias in reflection reflect weave awa avva; do
  if ! grep -Eq "(^|[^[:alnum:]_])${alias}([^[:alnum:]_]|$)" scripts/ava-reality; then
    missing_alias=1
  fi
done
if [[ "$missing_alias" -eq 0 ]]; then
  ok "historical AwA classifier compatibility"
else
  bad "historical AwA classifier compatibility" "historical alias not preserved"
fi
if python3 - <<'PY'
import json

with open("memory/auto-read/00_AI_COBUILD.json", encoding="utf-8") as fh:
    doc = json.load(fh)

seal = doc.get("verification", {}).get("last_web_seal", {})
classification = doc.get("verification", {}).get("last_web_seal_classification", {})
valid = (
    seal.get("checker") != "AvvA"
    or (
        classification.get("status") == "HISTORICAL"
        and classification.get("current_checker_contract") == "EXEMPT"
        and classification.get("historical_record") is True
    )
)
raise SystemExit(0 if valid else 1)
PY
then ok "historical AvvA checker record is exempt"; else bad "historical AvvA checker record is exempt" "historical exemption missing"; fi
if grep -qF "DAWA" scripts/ava-weave && ! grep -qF "DAVVA" scripts/ava-weave; then ok "weave human authority label"; else bad "weave human authority label" "authority drift"; fi
if grep -qF "git diff HEAD --check" scripts/ava-resume; then ok "resume checks staged + unstaged diff"; else bad "resume checks staged + unstaged diff" "HEAD-scoped diff proof missing"; fi
if grep -qF "AVA_ROOT does not match this repository" scripts/ava-resume; then ok "resume rejects redirected AVA_ROOT"; else bad "resume rejects redirected AVA_ROOT" "redirect guard missing"; fi
if ! grep -qF "/var/home/VVgbon/Avalhla" scripts/ava-resume; then ok "resume derives repository root"; else bad "resume derives repository root" "hardcoded root remains"; fi
if scripts/ava-sublime-update --paths >/dev/null 2>&1; then ok "Sublime updater resolves paths"; else bad "Sublime updater resolves paths" "path resolution failed"; fi
if grep -qF "Dawa_Notepad" scripts/ava-sublime-update && grep -qF "memory/auto-read" docs/DAWA_NOTEPAD.md; then ok "Sublime lane boundary"; else bad "Sublime lane boundary" "user/read lane contract missing"; fi
printf "%s\n" "" "-- executable doors --"
for f in scripts/ava-cobuilder scripts/ava-ci-contract scripts/ava-github-review scripts/ava-resume scripts/ava-sublime-update; do
  if [[ "$(stat -c "%a" "$f" 2>/dev/null)" == "755" ]]; then
    ok "mode 755 ${f#$ROOT/}"
  else
    bad "mode 755 ${f#$ROOT/}" "expected executable door mode 755"
  fi
done
if python3 -m json.tool config/sublime/Preferences.sublime-settings >/dev/null; then ok "Sublime Preferences JSON parses"; else bad "Sublime Preferences JSON parses" "invalid JSON"; fi
if python3 -m json.tool config/sublime/Dawa_Avalhla.sublime-project >/dev/null; then ok "Sublime project JSON parses"; else bad "Sublime project JSON parses" "invalid JSON"; fi
if scripts/ava-sublime-update --paths >/dev/null 2>&1; then ok "Sublime updater resolves paths"; else bad "Sublime updater resolves paths" "path resolution failed"; fi
if grep -qF "Dawa_Notepad" scripts/ava-sublime-update && grep -qF "memory/auto-read" docs/DAWA_NOTEPAD.md; then ok "Sublime lane boundary"; else bad "Sublime lane boundary" "user/read lane contract missing"; fi

printf "%s\n" "" "== summary =="
printf "  pass: %d\n  fail: %d\n" "$PASS" "$FAIL"
if [[ "$FAIL" -eq 0 ]]; then printf "%s\n" "  result: ALL GREEN"; else printf "%s\n" "  result: FAIL"; exit 1; fi