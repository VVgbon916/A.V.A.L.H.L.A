#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

PASS=0
FAIL=0
ok() { printf "  [ OK ] %s\n" "$1"; PASS=$((PASS + 1)); }
bad() { printf "  [FAIL] %s -- %s\n" "$1" "$2"; FAIL=$((FAIL + 1)); }
printf "%s\n" "== avalhla static contract =="
printf "root: %s\n\n" "$ROOT"
printf "%s\n" "-- canonical files --"
for f in docs/FAST_VIEW.md docs/AVALHLA_SPINE.md docs/PHASING.md docs/CO_BUILDER_TOOLBELT.md docs/DAWA_NOTEPAD.md config/sublime/Preferences.sublime-settings memory/auto-read/00_AI_COBUILD.json config/color/avalhla-color-field.v1.json config/integrity/avalhla-integrity.v1.json scripts/ava-cobuilder scripts/lib_color_field.sh scripts/lib_integrity.sh tests/test_color_field.sh tests/test_integrity.sh scripts/ava-sublime-update scripts/ava-resume scripts/ava-github-review scripts/ava-ci-contract AGENTS.md .github/workflows/avalhla-static-verify.yml; do
  [[ -f "$f" ]] && ok "present $f" || bad "present $f" "missing"
done

printf "%s\n" "" "-- shell syntax --"
while IFS= read -r -d "" f; do
  if bash -n "$f" >/dev/null 2>&1; then ok "bash -n ${f#$ROOT/}"; else bad "bash -n ${f#$ROOT/}" "syntax error"; fi
done < <(find scripts -maxdepth 1 -type f -perm -u+x -print0 2>/dev/null)

printf "%s\n" "" "-- JSON --"
if python3 -m json.tool memory/auto-read/00_AI_COBUILD.json >/dev/null; then ok "CoBuilder JSON parses"; else bad "CoBuilder JSON parses" "invalid JSON"; fi
if python3 -m json.tool config/color/avalhla-color-field.v1.json >/dev/null; then ok "Color Field JSON parses"; else bad "Color Field JSON parses" "invalid JSON"; fi
if python3 -m json.tool config/integrity/avalhla-integrity.v1.json >/dev/null; then ok "Integrity registry JSON parses"; else bad "Integrity registry JSON parses" "invalid JSON"; fi
if tests/test_color_field.sh >/dev/null 2>&1; then ok "Color Field contract"; else bad "Color Field contract" "test failed"; fi
if tests/test_integrity.sh >/dev/null 2>&1; then ok "SHA-256 integrity contract"; else bad "SHA-256 integrity contract" "test failed"; fi

printf "%s\n" "" "-- semantic invariants --"
if git grep -n -E "DAVVA|Dawa > AwA < Avalhla|Dawa > AvvA < Avalhla|Dawa <---- AwA ----> Avalhla" -- ":!memory/conversations/" ":!memory/reflections/" ":!memory/auto-read/00_AI_COBUILD.json" ":!scripts/ava-ci-contract" >/dev/null 2>&1; then
  bad "authority/relation naming" "active legacy or DAVVA label found"
else
  ok "authority/relation naming"
fi
missing_alias=0
for alias in reflection reflect weave awa avva; do
  if ! grep -Eq "(^|[^[:alnum:]_])${alias}([^[:alnum:]_]|$)" scripts/ava-reality; then
    missing_alias=1
  fi
done
if [[ "$missing_alias" -eq 0 ]]; then
  ok "historical AwA classifier compatibility"
else
  bad "historical AwA classifier compatibility" "historical alias not preserved"
fi
if python3 - <<'PY'
import json

with open("memory/auto-read/00_AI_COBUILD.json", encoding="utf-8") as fh:
    doc = json.load(fh)

seal = doc.get("verification", {}).get("last_web_seal", {})
classification = doc.get("verification", {}).get("last_web_seal_classification", {})
valid = (
    seal.get("checker") != "AvvA"
    or (
        classification.get("status") == "HISTORICAL"
        and classification.get("current_checker_contract") == "EXEMPT"
        and classification.get("historical_record") is True
    )
)
raise SystemExit(0 if valid else 1)
PY
then ok "historical AvvA checker record is exempt"; else bad "historical AvvA checker record is exempt" "historical exemption missing"; fi
if grep -qF "DAWA" scripts/ava-weave && ! grep -qF "DAVVA" scripts/ava-weave; then ok "weave human authority label"; else bad "weave human authority label" "authority drift"; fi
if grep -qF "git diff HEAD --check" scripts/ava-resume; then ok "resume checks staged + unstaged diff"; else bad "resume checks staged + unstaged diff" "HEAD-scoped diff proof missing"; fi
if grep -qF "AVA_ROOT does not match this repository" scripts/ava-resume; then ok "resume rejects redirected AVA_ROOT"; else bad "resume rejects redirected AVA_ROOT" "redirect guard missing"; fi
if ! grep -qF "/var/home/VVgbon/Avalhla" scripts/ava-resume; then ok "resume derives repository root"; else bad "resume derives repository root" "hardcoded root remains"; fi
if scripts/ava-sublime-update --paths >/dev/null 2>&1; then ok "Sublime updater resolves paths"; else bad "Sublime updater resolves paths" "path resolution failed"; fi
if grep -qF "Preferences.sublime-settings" scripts/ava-sublime-update && ! grep -qF "Dawa_Notepad" scripts/ava-sublime-update; then ok "Sublime updater boundary"; else bad "Sublime updater boundary" "private Dawa dependency remains"; fi
printf "%s\n" "" "-- public/private Dawa boundary --"
if [[ ! -e "Dawa_Notepad" ]]; then
  ok "public Dawa directory absent"
else
  bad "public Dawa directory absent" "Dawa_Notepad remains in public tree"
fi

if grep -qF "VVgbon916/Dawa_Notepad" docs/DAWA_NOTEPAD.md \
  && grep -qF "PRIVATE != AUTO-READ" docs/DAWA_NOTEPAD.md \
  && grep -qF "memory/auto-read/" docs/DAWA_NOTEPAD.md; then
  ok "public/private Dawa boundary documented"
else
  bad "public/private Dawa boundary documented" "boundary documentation incomplete"
fi

if grep -qF "Dawa_Notepad" scripts/ava-sublime-update; then
  bad "Sublime updater isolation" "private Dawa dependency remains"
else
  ok "Sublime updater isolation"
fi

if python3 - <<'PY2'
import json

with open("memory/auto-read/00_AI_COBUILD.json", encoding="utf-8") as fh:
    doc = json.load(fh)

wb = doc["workspace_boundaries_2026_09_27"]

assert wb["dawa_notepad"]["repository"] == "VVgbon916/Dawa_Notepad"
assert wb["dawa_notepad"]["visibility"] == "PRIVATE"
assert wb["dawa_notepad"]["repository_state"] == "EXTERNAL_PRIVATE_REPOSITORY"
assert wb["dawa_notepad"]["ava_implicit_read"] is False
assert wb["dawa_notepad"]["auto_read_membership"] is False

assert wb["avalhla_read_files"]["canonical_repository_path"] == "memory/auto-read/"
assert wb["avalhla_read_files"]["dawa_notepad_membership"] is False

assert wb["sublime_workspace"]["canonical_project_repository"] == "VVgbon916/Dawa_Notepad"
assert wb["sublime_workspace"]["canonical_project_path"] == "Dawa_Avalhla.sublime-project"

assert wb["sublime_workspace"]["dawa_lane"]["visibility"] == "PRIVATE"
assert wb["sublime_workspace"]["dawa_lane"]["ava_implicit_read"] is False
assert wb["sublime_workspace"]["dawa_lane"]["auto_read_membership"] is False
PY2
then
  ok "private repository machine-state semantics"
else
  bad "private repository machine-state semantics" "external/private state is ambiguous or stale"
fi

if python3 - <<'PY2'
from pathlib import Path

lines = Path(".gitignore").read_text(encoding="utf-8").splitlines()
legacy = any(
    "Dawa_Notepad" in line
    and ("private/" in line or "sublime-workspace" in line)
    for line in lines
)
raise SystemExit(0 if legacy else 1)
PY2
then
  bad "legacy public Dawa ignore rules absent" "legacy public-lane ignore rule remains"
else
  ok "legacy public Dawa ignore rules absent"
fi

printf "%s\n" "" "-- executable doors --"
for f in scripts/ava-cobuilder scripts/ava-ci-contract scripts/ava-github-review scripts/ava-resume scripts/ava-sublime-update; do
  if [[ "$(stat -c "%a" "$f" 2>/dev/null)" == "755" ]]; then
    ok "mode 755 ${f#$ROOT/}"
  else
    bad "mode 755 ${f#$ROOT/}" "expected executable door mode 755"
  fi
done
if python3 -m json.tool config/sublime/Preferences.sublime-settings >/dev/null; then ok "Sublime Preferences JSON parses"; else bad "Sublime Preferences JSON parses" "invalid JSON"; fi

printf "%s\n" "" "== summary =="
printf "  pass: %d\n  fail: %d\n" "$PASS" "$FAIL"
if [[ "$FAIL" -eq 0 ]]; then
  printf "%s\n" "  result: ALL GREEN"
else
  printf "%s\n" "  result: FAIL"
  exit 1
fi
