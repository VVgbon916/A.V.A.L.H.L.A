#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
PREF_SOURCE="$ROOT/config/sublime/Preferences.sublime-settings"
BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/avalhla/sublime-backups"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

ST_DATA="$XDG_CONFIG_HOME/sublime-text"
if [[ ! -d "$ST_DATA" && -d "$XDG_CONFIG_HOME/sublime-text-3" ]]; then
  ST_DATA="$XDG_CONFIG_HOME/sublime-text-3"
fi

USER_DIR="$ST_DATA/Packages/User"
PREF_TARGET="$USER_DIR/Preferences.sublime-settings"

usage() {
  cat <<'USAGE'
usage: ava-sublime-update [--check] [--apply] [--paths]

  --check   verify canonical Sublime settings against the user target
  --apply   install canonical Preferences.sublime-settings
  --paths   print resolved source and target paths

Default: --check

This door updates Avalhla Sublime user settings only.
It does not read, sync, ingest, or mutate the private Dawa repository.
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_source() {
  [[ -r "$PREF_SOURCE" ]] || die "missing source: $PREF_SOURCE"
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  python3 -m json.tool "$PREF_SOURCE" >/dev/null
}

print_paths() {
  printf '%s\n' '=== AVALHLA SUBLIME PATHS ==='
  printf 'ROOT           %s\n' "$ROOT"
  printf 'PREF_SOURCE    %s\n' "$PREF_SOURCE"
  printf 'PREF_TARGET    %s\n' "$PREF_TARGET"
  printf 'BACKUP_DIR     %s\n' "$BACKUP_DIR"
}

backup_target() {
  local target="$1"
  local label="$2"
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)-$$"
  mkdir -p "$BACKUP_DIR"
  cp -p -- "$target" "$BACKUP_DIR/$label.$stamp.bak"
  printf '  backup        %s\n' "$BACKUP_DIR/$label.$stamp.bak"
}

atomic_install() {
  local source="$1"
  local target="$2"
  local parent tmp
  parent="$(dirname -- "$target")"
  mkdir -p "$parent"
  tmp="$(mktemp "$parent/.avalhla-sync.XXXXXX")"
  trap 'rm -f -- "$tmp"' RETURN
  cp -- "$source" "$tmp"
  chmod 0644 "$tmp"
  mv -f -- "$tmp" "$target"
  trap - RETURN
}

check() {
  require_source
  print_paths
  printf '\n%s\n' '=== CHECK ==='

  if cmp -s "$PREF_SOURCE" "$PREF_TARGET" 2>/dev/null; then
    printf '%s\n' '  [ MATCH ] Preferences'
    printf '%s\n' 'CHECK PASS'
    return 0
  fi

  printf '%s\n' '  [ DRIFT/MISSING ] Preferences'
  printf '%s\n' 'CHECK FAIL'
  return 1
}

apply() {
  require_source
  printf '%s\n' '=== APPLY USER SETTINGS ==='

  if [[ -e "$PREF_TARGET" ]]; then
    if cmp -s "$PREF_SOURCE" "$PREF_TARGET"; then
      printf '%s\n' '  already       Preferences.sublime-settings matches'
      return 0
    fi
    backup_target "$PREF_TARGET" 'Preferences.sublime-settings'
  fi

  atomic_install "$PREF_SOURCE" "$PREF_TARGET"
  printf '  installed     %s\n' "$PREF_TARGET"
}

case "${1:-check}" in
  --check) check ;;
  --apply) apply ;;
  --paths) print_paths ;;
  -h|--help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
