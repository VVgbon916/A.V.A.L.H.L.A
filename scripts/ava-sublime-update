#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
PREF_SOURCE="$ROOT/config/sublime/Preferences.sublime-settings"
DAWA_DIR="$ROOT/Dawa_Notepad"
PROJECT_FILE="$DAWA_DIR/Dawa_Avalhla.sublime-project"
BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/avalhla/sublime-backups"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

ST_DATA="$XDG_CONFIG_HOME/sublime-text"
if [[ ! -d "$ST_DATA" && -d "$XDG_CONFIG_HOME/sublime-text-3" ]]; then
  ST_DATA="$XDG_CONFIG_HOME/sublime-text-3"
fi

USER_DIR="$ST_DATA/Packages/User"
PREF_TARGET="$USER_DIR/Preferences.sublime-settings"

usage() {
  cat <<'EOF'
usage: ava-sublime-update [--check] [--apply] [--paths]

  --check   verify canonical Sublime settings and repo-local Dawa project
  --apply   install canonical Preferences.sublime-settings
  --paths   print resolved source and target paths

Default: --check

Dawa_Notepad is now a tracked repository lane.
Repository sync refreshes its project file. This door does not move,
read, ingest, or auto-import Dawa_Notepad content.
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_sources() {
  [[ -r "$PREF_SOURCE" ]] || die "missing source: $PREF_SOURCE"
  [[ -r "$PROJECT_FILE" ]] || die "missing project: $PROJECT_FILE"
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  python3 -m json.tool "$PREF_SOURCE" >/dev/null
  python3 -m json.tool "$PROJECT_FILE" >/dev/null
}

print_paths() {
  printf '%s\n' '=== AVALHLA SUBLIME PATHS ==='
  printf 'ROOT           %s\n' "$ROOT"
  printf 'PREF_SOURCE    %s\n' "$PREF_SOURCE"
  printf 'PREF_TARGET    %s\n' "$PREF_TARGET"
  printf 'DAWA_DIR       %s\n' "$DAWA_DIR"
  printf 'PROJECT_FILE   %s\n' "$PROJECT_FILE"
  printf 'BACKUP_DIR     %s\n' "$BACKUP_DIR"
}

backup_target() {
  local target="$1"
  local label="$2"
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)-$$"
  mkdir -p "$BACKUP_DIR"
  cp -p -- "$target" "$BACKUP_DIR/$label.$stamp.bak"
  printf '  backup        %s\n' "$BACKUP_DIR/$label.$stamp.bak"
}

atomic_install() {
  local source="$1"
  local target="$2"
  local parent tmp
  parent="$(dirname -- "$target")"
  mkdir -p "$parent"
  tmp="$(mktemp "$parent/.avalhla-sync.XXXXXX")"
  trap 'rm -f -- "$tmp"' RETURN
  cp -- "$source" "$tmp"
  chmod 0644 "$tmp"
  mv -f -- "$tmp" "$target"
  trap - RETURN
}

check() {
  local bad=0
  require_sources
  print_paths
  printf '\n%s\n' '=== CHECK ==='

  if cmp -s "$PREF_SOURCE" "$PREF_TARGET" 2>/dev/null; then
    printf '%s\n' '  [ MATCH ] Preferences'
  else
    printf '%s\n' '  [ DRIFT/MISSING ] Preferences'
    bad=1
  fi

  if [[ -f "$PROJECT_FILE" ]]; then
    printf '%s\n' '  [ PRESENT ] Dawa project'
  else
    printf '%s\n' '  [ MISSING ] Dawa project'
    bad=1
  fi

  if python3 - "$PROJECT_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as fh:
    doc = json.load(fh)

folders = doc.get("folders")
paths = [item.get("path") for item in folders or [] if isinstance(item, dict)]
raise SystemExit(0 if "." in paths and "../memory/auto-read" in paths else 1)
PY
  then
    printf '%s\n' '  [ MATCH ] two-lane project paths'
  else
    printf '%s\n' '  [ DRIFT ] two-lane project paths'
    bad=1
  fi

  if (( bad == 0 )); then
    printf '%s\n' 'CHECK PASS'
  else
    printf '%s\n' 'CHECK FAIL'
    return 1
  fi
}

apply() {
  require_sources
  printf '%s\n' '=== APPLY USER SETTINGS ==='
  if [[ -e "$PREF_TARGET" ]]; then
    if cmp -s "$PREF_SOURCE" "$PREF_TARGET"; then
      printf '%s\n' '  already       Preferences.sublime-settings matches'
      return 0
    fi
    backup_target "$PREF_TARGET" 'Preferences.sublime-settings'
  fi
  atomic_install "$PREF_SOURCE" "$PREF_TARGET"
  printf '  installed     %s\n' "$PREF_TARGET"
}

print_paths
case "${1:-check}" in
  --check)
    check
    ;;
  --apply)
    apply
    ;;
  --paths)
    exit 0
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
