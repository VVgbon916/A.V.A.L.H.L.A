#!/usr/bin/env python3
"""Validate and safely apply Avalhla-owned MCP entries to one client."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


CLIENT_CONFIGS = {
    "claude_code": Path.home() / ".claude.json",
    "codex_cli": Path.home() / ".codex" / "config.toml",
    "copilot": Path.home() / ".copilot" / "mcp-config.json",
    "dawa_desktop": Path.home() / ".config" / "Claude" / "claude_desktop_config.json",
}


class SetupError(RuntimeError):
    pass


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SetupError(f"invalid JSON config: {path}: {exc}") from exc


def load_manifest(path: Path) -> dict:
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SetupError(f"invalid manifest: {path}: {exc}") from exc
    if manifest.get("schema_version") != "avalhla-multi-client.v1":
        raise SetupError("unsupported multi-client manifest schema")
    return manifest


def target_for(args: argparse.Namespace) -> Path:
    return Path(args.config).expanduser() if args.config else CLIENT_CONFIGS[args.client]


def desktop_spec(args: argparse.Namespace) -> dict | None:
    node = args.desktop_node or os.environ.get("AVALHLA_NODE_BIN")
    entrypoint = args.desktop_entrypoint or os.environ.get("AVALHLA_DESKTOP_ENTRYPOINT")
    if bool(node) != bool(entrypoint):
        raise SetupError("Desktop Commander requires both node executable and entrypoint")
    if node and entrypoint:
        node_path = Path(node).expanduser()
        entry_path = Path(entrypoint).expanduser()
        if not node_path.exists() or not os.access(node_path, os.X_OK):
            raise SetupError(f"Desktop Commander node is not executable: {node_path}")
        if not entry_path.is_file():
            raise SetupError(f"Desktop Commander entrypoint is missing: {entry_path}")
        return {"command": str(node_path), "args": [str(entry_path)]}
    candidate = args.desktop_command or os.environ.get("AVALHLA_DESKTOP_COMMAND")
    if not candidate:
        return None
    path = Path(candidate).expanduser()
    if not path.exists() or not os.access(path, os.X_OK):
        raise SetupError(f"Desktop Commander executable is not executable: {path}")
    return {"command": str(path)}


def desired_servers(manifest: dict, args: argparse.Namespace, target: Path) -> dict[str, dict]:
    servers = {}
    remote = manifest["mcp"]["avalhla"]
    servers["avalhla"] = {"url": remote["url"]} if target.suffix == ".toml" else {"type": "http", "url": remote["url"]}
    command = desktop_spec(args)
    if command:
        servers["desktop-commander"] = command
    return servers


def ensure_client(manifest: dict, client: str) -> None:
    if client not in manifest.get("clients", {}):
        raise SetupError(f"unknown client: {client}")


def json_changes(config: dict, desired: dict[str, dict]) -> list[tuple[str, str]]:
    current = config.get("mcpServers")
    if current is None:
        current = {}
    if not isinstance(current, dict):
        raise SetupError("JSON config mcpServers must be an object")
    changes = []
    for name, value in desired.items():
        if name not in current:
            action = "add"
        elif not isinstance(current[name], dict):
            action = "update"
        else:
            projected = dict(current[name])
            projected.update(value)
            action = "update" if not values_equal(projected, current[name]) else "unchanged"
        changes.append((action, name))
    return changes


def values_equal(left, right) -> bool:
    """Compare config values while treating equivalent absolute symlink paths equally."""
    if isinstance(left, dict) and isinstance(right, dict):
        return left.keys() == right.keys() and all(values_equal(left[key], right[key]) for key in left)
    if isinstance(left, list) and isinstance(right, list):
        return len(left) == len(right) and all(values_equal(a, b) for a, b in zip(left, right))
    if isinstance(left, str) and isinstance(right, str):
        if left.startswith("/") and right.startswith("/"):
            left_path = Path(left)
            right_path = Path(right)
            if left_path.exists() or right_path.exists():
                return left_path.resolve() == right_path.resolve()
    return left == right


def apply_json(config: dict, desired: dict[str, dict]) -> dict:
    result = dict(config)
    servers = result.get("mcpServers")
    if servers is None:
        servers = {}
    if not isinstance(servers, dict):
        raise SetupError("JSON config mcpServers must be an object")
    merged = dict(servers)
    for name, value in desired.items():
        existing = merged.get(name)
        if isinstance(existing, dict):
            updated = dict(existing)
            updated.update(value)
            merged[name] = updated
        else:
            merged[name] = value
    result["mcpServers"] = merged
    return result


def load_toml(path: Path) -> str:
    text = path.read_text(encoding="utf-8")
    try:
        import tomllib

        tomllib.loads(text)
    except Exception as exc:  # noqa: BLE001 - reports malformed user config
        raise SetupError(f"invalid TOML config: {path}: {exc}") from exc
    return text


def toml_section_name(name: str) -> str:
    return f"[mcp_servers.{name}]"


def toml_has_section(text: str, name: str) -> bool:
    return re.search(rf"(?m)^\[mcp_servers\.{re.escape(name)}\]\s*$", text) is not None


def toml_value(key: str, item) -> str:
    if isinstance(item, str):
        return f'{key} = {json.dumps(item)}\n'
    if isinstance(item, bool):
        return f"{key} = {'true' if item else 'false'}\n"
    return f"{key} = {json.dumps(item)}\n"


def update_toml_section(text: str, name: str, value: dict) -> str:
    lines = text.splitlines(keepends=True)
    section = toml_section_name(name)
    try:
        start = next(index for index, line in enumerate(lines) if line.strip() == section)
    except StopIteration as exc:
        raise SetupError(f"TOML section disappeared: {section}") from exc
    end = next((index for index in range(start + 1, len(lines)) if lines[index].lstrip().startswith("[")), len(lines))
    body = lines[start + 1 : end]
    for key, item in value.items():
        replacement = toml_value(key, item)
        pattern = re.compile(rf"^\s*{re.escape(key)}\s*=")
        for index, line in enumerate(body):
            if pattern.match(line):
                body[index] = replacement
                break
        else:
            body.append(replacement)
    return "".join(lines[: start + 1] + body + lines[end:])


def apply_toml(text: str, desired: dict[str, dict]) -> tuple[str, list[tuple[str, str]]]:
    result = text.rstrip() + "\n"
    changes = []
    for name, value in desired.items():
        if toml_has_section(result, name):
            updated = update_toml_section(result, name, value)
            changes.append(("unchanged" if updated == result else "update", name))
            result = updated
            continue
        result += "\n" + toml_section_name(name) + "\n"
        for key, item in value.items():
            result += toml_value(key, item)
        changes.append(("add", name))
    return result, changes


def print_plan(args: argparse.Namespace, manifest: dict, target: Path, desired: dict) -> int:
    print(f"client={args.client} target={target}")
    if target.suffix == ".toml":
        text = load_toml(target)
        _, changes = apply_toml(text, desired)
    else:
        config = load_json(target)
        changes = json_changes(config, desired)
    for action, name in changes:
        print(f"action={action} server={name}")
    if "desktop-commander" not in desired:
        print("action=deferred server=desktop-commander reason=executable_not_supplied")
    return 0


def backup_and_replace(target: Path, content: str, backup_dir: Path) -> Path:
    backup_dir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = backup_dir / f"{target.name}.{stamp}.bak"
    shutil.copy2(target, backup)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=target.parent, delete=False) as handle:
        handle.write(content)
        temporary = Path(handle.name)
    os.replace(temporary, target)
    return backup


def apply_config(args: argparse.Namespace, manifest: dict, target: Path, desired: dict) -> int:
    if target.suffix == ".toml":
        original = load_toml(target)
        updated, changes = apply_toml(original, desired)
        content = updated
    else:
        original = target.read_text(encoding="utf-8")
        config = load_json(target)
        updated = apply_json(config, desired)
        content = json.dumps(updated, indent=2, ensure_ascii=False) + "\n"
        changes = json_changes(config, desired)
        if all(action == "unchanged" for action, _ in changes):
            print(f"unchanged client={args.client} target={target}")
            return 0
    if content == original:
        print(f"unchanged client={args.client} target={target}")
        return 0
    backup = backup_and_replace(target, content, Path(args.backup_dir).expanduser())
    print(f"applied client={args.client} target={target} backup={backup}")
    for action, name in changes:
        print(f"action={action} server={name}")
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("check", "plan", "apply"))
    parser.add_argument("--manifest", default="config/avalhla-multi-client.v1.json")
    parser.add_argument("--client", required=True, choices=sorted(CLIENT_CONFIGS))
    parser.add_argument("--config")
    parser.add_argument("--desktop-command")
    parser.add_argument("--desktop-node")
    parser.add_argument("--desktop-entrypoint")
    parser.add_argument("--backup-dir", default="~/.local/state/avalhla/backups")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        manifest = load_manifest(Path(args.manifest).expanduser())
        ensure_client(manifest, args.client)
        target = target_for(args)
        if not target.is_file():
            raise SetupError(f"target config does not exist: {target}")
        desired = desired_servers(manifest, args, target)
        if args.command == "check":
            if target.suffix == ".toml":
                load_toml(target)
            else:
                load_json(target)
            print(f"check=ok client={args.client} target={target}")
            if "desktop-commander" not in desired:
                print("deferred=desktop-commander reason=executable_not_supplied")
            return 0
        if args.command == "plan":
            return print_plan(args, manifest, target, desired)
        return apply_config(args, manifest, target, desired)
    except SetupError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
